{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-worker-boilerplate",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-15",

  // Tài khoản có nhiều account thì bỏ comment và điền Account ID (`npx wrangler whoami`).
  // "account_id": "<ACCOUNT_ID>",

  // App React (build bởi Vite). Đường dẫn lạ trả index.html để React tự route;
  // /api/* luôn chạy vào Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Database D1. Không cần database_id: lần deploy đầu Wrangler tự tạo database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-worker-boilerplate-db",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
